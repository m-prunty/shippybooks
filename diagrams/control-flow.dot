digraph "shippybooks control flow" {
  graph [rankdir=LR, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.55];
  node [shape=box, style="rounded,filled", fillcolor="#e8f0fe", color="#1d4ed8",
        fontname="Helvetica", fontsize=10, margin="0.12,0.07"];
  edge [color="#475569", arrowsize=0.7, fontname="Helvetica", fontsize=9, fontcolor="#334155"];

  client [label="HTTP client\n(curl / browser)", shape=ellipse, fillcolor="#f1f5f9"];

  subgraph cluster_api {
    label="FastAPI HTTP layer";
    style="rounded,filled"; fillcolor="#f8fafc"; color="#94a3b8";
    endpoints [label="api/endpoints/\nbooks.py · orders.py\nnotifications.py · health.py"];
    deps [label="api/dependencies.py\nCmdHandlerDep · QueryHandlerDep\nNotificationStoreDep"];
  }

  bootstrap [label="bootstrap.py\nbuild_app_state()\n(object graph wiring)"];
  main [label="main.py\ncreate_app() · uvicorn entry"];

  subgraph cluster_cmd {
    label="Command side (CQRS writes)";
    style="rounded,filled"; fillcolor="#fef2f2"; color="#ef4444";
    cmd_handler [label="services/command_handlers.py\nCommandHandler.handle()"];
    commands [label="domain/commands.py\nCreateBook · UpdateBookStock\nCreateOrder · ChangeOrderStatus"];
    aggregates [label="domain/models.py\nBook · Order · OrderItem"];
  }

  repos [label="services/repos.py\nBookRepository · OrderRepository"];

  subgraph cluster_db {
    label="Persistence";
    style="rounded,filled"; fillcolor="#f0fdf4"; color="#16a34a";
    orm [label="db/models.py\nBookORM · OrderORM · OrderItemORM"];
    session [label="db/session.py\nengine · get_session()\nSQLite (data.db)"];
  }

  subgraph cluster_events {
    label="Event-driven notifications";
    style="rounded,filled"; fillcolor="#fffbeb"; color="#d97706";
    bus [label="events/bus.py\nEventBus (publish/subscribe)"];
    events [label="domain/events.py\nBookCreated · OrderCreated ·\nOrderStatusChanged · BookUpdated"];
    dispatcher [label="events/notifications.py\nNotificationDispatcher"];
    notifications [label="events/notifications.py\nNotification subtypes\n(BookNotification, StockAlert,\nOrderConfirmation, StatusUpdate)"];
    handler [label="NotificationHandler.dispatch()"];
    store [label="events/store.py\nNotificationStore.append()\n(in-memory event log)"];
  }

  subgraph cluster_query {
    label="Query side (CQRS reads)";
    style="rounded,filled"; fillcolor="#f0f9ff"; color="#0284c7";
    qh [label="services/query_handlers.py\nQueryHandler.handle()"];
    queries [label="domain/queries.py\nGetBook · ListBooks ·\nGetOrder · ListOrders"];
  }

  client -> endpoints [label="POST / GET"];
  endpoints -> deps [label="Depends()"];
  deps -> cmd_handler;
  deps -> qh;
  bootstrap -> cmd_handler [style=dashed];
  bootstrap -> qh [style=dashed];
  bootstrap -> store [style=dashed];
  main -> bootstrap [label="build_app_state()", style=dashed];

  cmd_handler -> commands [label="isinstance dispatch"];
  cmd_handler -> aggregates [label="mutate"];
  cmd_handler -> repos [label="save / get"];
  repos -> orm [label="SQLAlchemy Session", style=dashed];
  orm -> session [label="bind", style=dashed];

  cmd_handler -> bus [label="publish(event)"];
  bus -> dispatcher [label="on_*()"];
  dispatcher -> notifications [label="build Notification"];
  notifications -> handler [label="dispatch()"];
  handler -> store [label="append()"];

  qh -> queries;
  qh -> repos [label="get / all"];
  repos -> aggregates [label="to_domain()"];

  store -> endpoints [label="SSE stream\nGET /api/v1/notifications/stream", style=dashed, constraint=false, color="#d97706"];
}
